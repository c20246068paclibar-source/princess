---
const {
  title = "Princess Paclibar",
  description = "Personal portfolio, payroll system, company website, startup website, and compliance monitoring system.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Princess Paclibar" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Set saved theme before the page displays -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("theme");
        document.documentElement.dataset.theme =
          savedTheme === "light" ? "light" : "dark";
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Princess Paclibar home">
        <span class="brand-mark">P</span>
        <span class="brand-name">Princess Paclibar</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#projects">Projects</a>
        <a href="/#services">Services</a>
        <a href="/#contact" class="nav-contact">Contact</a>
        <button id="theme-toggle" type="button" aria-label="Toggle theme">
          <span class="theme-icon" aria-hidden="true">◐</span>
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      © {new Date().getFullYear()} Princess Paclibar
    </footer>

    <script is:inline>
      const themeToggle = document.getElementById("theme-toggle");

      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          themeToggle.setAttribute(
            "aria-label",
            next === "dark" ? "Switch to light theme" : "Switch to dark theme"
          );
        });

        const currentTheme = document.documentElement.dataset.theme;
        themeToggle.setAttribute(
          "aria-label",
          currentTheme === "dark" ? "Switch to light theme" : "Switch to dark theme"
        );
      }
    </script>
  </body>
</html>

<style is:global>
  :root[data-theme="dark"] {
    --bg: #0f172a;
    --text: #e5e7eb;
    --muted: #94a3b8;
    --accent: #e11d48;
    --line: #1e293b;
  }
  :root[data-theme="light"] {
    --bg: #ffffff;
    --text: #111827;
    --muted: #6b7280;
    --accent: #be123c;
    --line: #e5e7eb;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: min(960px, 90%);
    margin: 0 auto;
    padding: 4rem 0;
    text-align: center;
  }

  h1, h2 { font-weight: 600; letter-spacing: -0.02em; }
  h1 { font-size: 2.5rem; color: var(--accent); }
  h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  p { color: var(--muted); }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(960px, calc(100% - 2rem));
    height: 64px;
    position: sticky;
    top: 1rem;
    z-index: 100;
    margin: 0 auto;
    padding: 0.55rem 0.65rem 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    font-size: 1rem;
  }

  .brand-name { letter-spacing: -0.02em; }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
  }

  .site-header nav > a {
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
  }

  .site-header nav > a:hover {
    background: var(--line);
    color: var(--text);
  }

  .site-header nav .nav-contact {
    background: var(--accent);
    color: #ffffff;
  }

  .site-header nav .nav-contact:hover {
    background: var(--accent);
    color: #ffffff;
    transform: translateY(-1px);
  }

  #theme-toggle {
    width: 38px;
    height: 38px;
    margin-left: 0.25rem;
    display: grid;
    place-items: center;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
  }
  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  @media (max-width: 560px) {
    .site-header {
      top: 0.65rem;
      width: calc(100% - 1.25rem);
    }
    .brand-name { display: none; }
    .site-header nav > a {
      padding: 0.5rem 0.55rem;
      font-size: 0.82rem;
    }
  }

  .site-footer {
    text-align: center;
    padding: 2rem 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>